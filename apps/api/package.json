{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "concurrently -n \"api,stripe\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:ingress\"",
    "dev:api": "nodemon --exec tsx src/server.ts",
    "dev:ingress": "chmod +x ./scripts/stripe-listen.sh && ./scripts/stripe-listen.sh",
    "build": "tsc -b && tsc-alias",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "drizzle:push": "npx drizzle-kit push",
    "drizzle:generate": "npx drizzle-kit generate",
    "drizzle:migrate": "npx drizzle-kit migrate",
    "drizzle:studio": "npx drizzle-kit studio",
    "drizzle:drop": "npx drizzle-kit drop",
    "drizzle:reset": "npx drizzle-kit drop && npx drizzle-kit push",
    "db:reset": "tsx src/lib/drizzle/scripts/drizzle.reset.ts",
    "seed": "tsx src/lib/drizzle/seed.ts",
    "pgboss:dashboard": "npx dotenv-cli -e .env -- sh -c 'PORT=3001 npx @pg-boss/dashboard'",
    "pgboss:list-tables": "npx dotenv-cli -e .env -- sh -c 'psql \"$DATABASE_URL\" -c \"\\\\dt pgboss.*\"'",
    "pgboss:clean": "npx dotenv-cli -e .env -- npx tsx src/lib/pg-boss/scripts/pgboss.clean.ts",
    "pgboss:unschedule": "npx dotenv-cli -e .env -- npx tsx src/lib/pg-boss/scripts/pgboss.unschedule.ts",
    "pgboss:inspect": "npx dotenv-cli -e .env -- npx tsx src/lib/pg-boss/scripts/pgboss.inspect.ts",
    "pgboss:delete-queues": "npx dotenv-cli -e .env -- npx tsx src/lib/pg-boss/scripts/pgboss.remove-queues.ts",
    "places:search": "npx dotenv-cli -e .env -- npx tsx src/lib/maps/places.search.ts",
    "plans:backfill": "dotenv -e .env -- tsx src/feature/plans/plans.backfill.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@pg-boss/dashboard": "^1.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "module-alias": "^2.3.4",
    "nodemon": "^3.1.11",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express-rate-limit": "^8.5.1",
    "glob": "^13.0.3",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "multer": "^2.0.2",
    "non-error": "^0.1.0",
    "opossum": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "pg-boss": "^12.12.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "stripe": "^21.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
